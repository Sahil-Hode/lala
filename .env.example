# ==========================================
# NEXUS INTEL — Environment Variables
# ==========================================

# MongoDB Database Connection (Recommended for Vercel / Cloud deployments)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus_intel?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus_intel?retryWrites=true&w=majority
MONGODB_DB=nexus_intel

# Alternative: MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus_intel
DB_USER=root
DB_PASSWORD=

# Authentication Secret (Used for signed JWT admin sessions)
# Generate a secure key, e.g. using `openssl rand -hex 32`
AUTH_SECRET=nexus_super_classified_jwt_secret_2026_change_in_production
ADMIN_SESSION_SECRET=nexus_super_classified_jwt_secret_2026_change_in_production

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image Upload Provider (Cloudinary for production/Vercel)
# Option A: Cloudinary Connection URL
CLOUDINARY_URL=

# Option B: Individual Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
